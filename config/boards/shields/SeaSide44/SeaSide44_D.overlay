#include <physical_layouts.dtsi>
#include "SeaSide44.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &SeaSide44_physical_layout;
    };

    /* ドングルには物理キーがないため mock kscan を使う */
    kscan0: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    /* 右トラックボールを split input として受信 */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        tb_right_split: tb_right_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            // layers 処理は input-listener で実装（scroll_layer 子ノード参照）
        };
    };

    /* ドングル側でトラックボール入力を処理 */
    tb_right_listener: tb_right_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&tb_right_split>;
//        automouse-layer = <4>;
//        scroll-layers = <5>;  /* 代わりに layers 子ノードで層別処理を実装 */

        /* レイヤー5: スクロール機能を有効化（XY → スクロール値に変換） */
        scroll_layer {
            layers = <5>;
            input-processors = <&zip_xy_to_scroll_mapper>;
        };
    };
};
