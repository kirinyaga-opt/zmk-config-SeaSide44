#include <physical_layouts.dtsi>
#include <input/processors.dtsi>
#include "SeaSide44.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &SeaSide44_physical_layout;
    };

    /* ドングルには物理キーがないため mock kscan を使う */
    kscan0: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    /* 右トラックボールを split input として受信 */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        tb_right_split: tb_right_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /* ドングル側でトラックボール入力を処理 */
    tb_right_listener: tb_right_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&tb_right_split>;
//        automouse-layer = <4>;
//        scroll-layers = <5>;

        scroll_layer {
            layers = <5>;
//            input-processors = <&zip_xy_to_scroll_mapper>;
            input-processors = <
                // 1. スクロールに変換する前に、まずY軸の信号だけを反転（invert）させる
                &zip_xy_invert_y
                // 2. その後、XY移動をスクロール移動に変換する
                &zip_xy_to_scroll_mapper
            >;
        };
    };
};
